<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="view" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.parking.coto.ui.VehiclesController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="view-title" text="Vehículos" />
                  <Label styleClass="view-subtitle" text="Registra los vehículos que pueden usar el parqueo." />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#onLoadSampleData" styleClass="ghost-button" text="Cargar datos de ejemplo" />
         </children>
      </HBox>
      <Label fx:id="feedbackLabel" maxWidth="Infinity" />
      <HBox spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox maxWidth="360.0" minWidth="320.0" prefWidth="360.0" spacing="8.0" styleClass="card">
               <children>
                  <Label styleClass="card-title" text="Nuevo vehículo" />
                  <Label styleClass="field-label" text="Tipo" />
                  <ComboBox fx:id="vehicleTypeCombo" maxWidth="Infinity" promptText="Seleccione el tipo" />
                  <Label styleClass="field-label" text="Placa" />
                  <TextField fx:id="plateField" promptText="Ej.: ABC123" />
                  <Label styleClass="field-label" text="Marca" />
                  <TextField fx:id="brandField" promptText="Ej.: Toyota" />
                  <Label styleClass="field-label" text="Modelo" />
                  <TextField fx:id="modelField" promptText="Ej.: Corolla" />
                  <Label styleClass="field-label" text="Color" />
                  <TextField fx:id="colorField" promptText="Ej.: Blanco" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onRegisterVehicle" styleClass="primary-button" text="Registrar vehículo" />
               </children>
            </VBox>
            <VBox maxWidth="Infinity" spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label maxWidth="Infinity" styleClass="card-title" text="Vehículos registrados" HBox.hgrow="ALWAYS" />
                        <Label fx:id="countLabel" styleClass="muted" />
                     </children>
                  </HBox>
                  <TableView fx:id="vehiclesTable" VBox.vgrow="ALWAYS">
                     <placeholder>
                        <Label text="Todavía no hay vehículos registrados" />
                     </placeholder>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
