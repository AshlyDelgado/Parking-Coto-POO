<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="view" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.parking.coto.ui.PaymentController">
   <children>
      <VBox spacing="2.0">
         <children>
            <Label styleClass="view-title" text="Registrar pago" />
            <Label styleClass="view-subtitle" text="Cobra un ticket cerrado. Un ticket que sigue activo no se puede pagar." />
         </children>
      </VBox>
      <Label fx:id="feedbackLabel" maxWidth="Infinity" />
      <HBox>
         <children>
            <VBox maxWidth="680.0" prefWidth="680.0" spacing="8.0" styleClass="card">
               <children>
                  <Label styleClass="field-label" text="Ticket" />
                  <ComboBox fx:id="ticketCombo" maxWidth="Infinity" promptText="Seleccione un ticket sin pagar" />
                  <Label styleClass="field-label" text="Tipo de pago" />
                  <ComboBox fx:id="paymentTypeCombo" maxWidth="Infinity" />
                  <Label styleClass="field-label" text="Fecha y hora del pago" />
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <DatePicker fx:id="datePicker" prefWidth="160.0" />
                        <TextField fx:id="timeField" prefWidth="80.0" promptText="HH:mm" />
                     </children>
                  </HBox>
                  <Label styleClass="hint" text="Hora en formato de 24 horas: 00:00 es la medianoche y 12:00 es el mediodía." />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onRegisterPayment" styleClass="primary-button" text="Registrar pago" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
